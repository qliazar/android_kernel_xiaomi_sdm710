# Platform
CONFIG_MACH_XIAOMI_PYXIS=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_MI=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_FOD=y

# Power supply
# CONFIG_SMB1355_SLAVE_CHARGER is not set
# CONFIG_SMB1390_CHARGE_PUMP is not set

# CoreSight Tracing
# CONFIG_CORESIGHT is not set

# Test Fixtures
# CONFIG_MMC_TEST is not set
# CONFIG_USB_EHSET_TEST_FIXTURE is not set
# CONFIG_USB_LINK_LAYER_TEST is not set
# CONFIG_IOMMU_TESTS is not set

# Debug & Tracing Bloat
# CONFIG_DEBUG_INFO is not set
# CONFIG_KALLSYMS_ALL is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_SCSI_LOGGING is not set
# CONFIG_SCSI_UFSHCD_CMD_LOGGING is not set
# CONFIG_IOMMU_DEBUG is not set
# CONFIG_IOMMU_DEBUG_TRACKING is not set
# CONFIG_DRM_SDE_EVTLOG_DEBUG is not set
# CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG is not set
# CONFIG_DM_DEBUG is not set
# CONFIG_SPMI_MSM_PMIC_ARB_DEBUG is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
# CONFIG_QMP_DEBUGFS_CLIENT is not set
# CONFIG_TRACER_PKT is not set
# CONFIG_RMNET_DATA_DEBUG_PKT is not set
# CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS is not set
# CONFIG_MSM_BOOT_STATS is not set

# Dead Subsystems
# CONFIG_DVB_MPQ is not set
# CONFIG_MTD is not set

# TCP Congestion Control
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# I/O Scheduler
CONFIG_IOSCHED_DEADLINE=y
CONFIG_DEFAULT_DEADLINE=y
# CONFIG_DEFAULT_MAPLE is not set
CONFIG_DEFAULT_IOSCHED="deadline"

# KernelSU-Next
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Timer Frequency
# CONFIG_HZ_100 is not set
CONFIG_HZ_300=y
CONFIG_HZ=300

# Power-efficient Workqueues
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Localversion
CONFIG_LOCALVERSION="-qliazar"

# ZRAM LZ4 Compression
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"

# Boeffla Wakelock Blocker
CONFIG_BOEFFLA_WL_BLOCKER=y



